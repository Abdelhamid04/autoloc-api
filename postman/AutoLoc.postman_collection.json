                 {
                     "name":  "Contrat et paiements - cascade",
                     "item":  [
                                  {
                                      "name":  "1. Créer contrat avec deux paiements",
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\"dateSignature\":\"2026-01-10\",\"montantTotal\":500.00,\"valide\":true,\"paiements\":[{\"montant\":250.00,\"datePaiement\":\"2026-01-10\",\"modePaiement\":\"CARTE\"},{\"montant\":250.00,\"datePaiement\":\"2026-01-11\",\"modePaiement\":\"VIREMENT\"}]}"
                                                               },
                                                      "url":  "{{baseUrl}}/contrats"
                                                  },
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "pm.test(\u0027201 Created\u0027, () =\u003e pm.response.to.have.status(201));",
                                                                                    "const body = pm.response.json();",
                                                                                    "pm.environment.set(\u0027contratId\u0027, body.idContrat);"
                                                                                ]
                                                                   }
                                                    }
                                                ]
                                  },
                                  {
                                      "name":  "2. Lister paiements persistés",
                                      "request":  {
                                                      "method":  "GET",
                                                      "url":  "{{baseUrl}}/paiements"
                                                  },
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "pm.test(\u0027200 OK et paiements présents\u0027, () =\u003e { pm.response.to.have.status(200); const payments = pm.response.json(); pm.expect(payments.filter(p =\u003e p.contrat \u0026\u0026 p.contrat.idContrat == pm.environment.get(\u0027contratId\u0027)).length).to.be.greaterThan(0); });"
                                                                                ]
                                                                   }
                                                    }
                                                ]
                                  },
                                  {
                                      "name":  "3. Modifier contrat, garder paiements",
                                      "request":  {
                                                      "method":  "PUT",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\"dateSignature\":\"2026-01-10\",\"montantTotal\":510.00,\"valide\":true}"
                                                               },
                                                      "url":  "{{baseUrl}}/contrats/{{contratId}}"
                                                  },
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "pm.test(\u0027200 OK\u0027, () =\u003e pm.response.to.have.status(200));"
                                                                                ]
                                                                   }
                                                    }
                                                ]
                                  },
                                  {
                                      "name":  "4. Supprimer contrat",
